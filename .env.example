# BookLoop OE Project — Environment Variables
# Copy this file to .env and fill in your own credentials

# Supabase (required for photo uploads — create a free project at supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API (optional — leave blank for demo/mock mode)
# Get your key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
